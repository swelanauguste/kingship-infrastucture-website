# Copy to .env.docker or generate with python3 scripts/setup_docker.py.
SECRET_KEY=replace-with-a-long-random-secret
DB_NAME=ministry_website_dev
DB_USER=ministry_website_dev
DB_PASSWORD=replace-with-a-unique-database-password
APP_PORT=8000
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,ministry.localhost,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://ministry.localhost,http://ministry.localhost:8080
DEFAULT_FROM_EMAIL=Ministry updates <updates@ministry.localhost>
REDIS_URL=redis://shared-redis:6379/12
SHARED_DATABASE_NETWORK=shared-dev-database
SHARED_PROXY_NETWORK=shared-dev-proxy
